# Copy this file to .env and fill in your Confluent Cloud credentials:
#   cp .env.example .env
# Never commit the real .env file.

# Kafka cluster
# Confluent Cloud → Cluster → Cluster settings → Bootstrap server
KAFKA_BOOTSTRAP_SERVERS=pkc-xxxxx.us-east-1.aws.confluent.cloud:9092
# Confluent Cloud → Cluster → API keys
KAFKA_API_KEY=your-kafka-api-key
KAFKA_API_SECRET=your-kafka-api-secret

# Schema Registry
# Confluent Cloud → Environment → Schema Registry → Endpoint
SCHEMA_REGISTRY_URL=https://psrc-xxxxx.us-east-1.aws.confluent.cloud
# Confluent Cloud → Environment → Schema Registry → API keys
SCHEMA_REGISTRY_API_KEY=your-schema-registry-api-key
SCHEMA_REGISTRY_API_SECRET=your-schema-registry-api-secret

